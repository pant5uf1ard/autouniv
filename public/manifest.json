{
  "manifest_version": 3,
  "name": "Icampus Manager",
  "version": "1.3.0",
  "icons": {
    "128": "./icon128.png",
    "48": "./icon48.png",
    "32": "./icon32.png",
    "16": "./icon16.png"
  },

  "action": {
    "default_icon": {
      "32": "./icon32.png"
    },
    "default_title": "icampus manager",
    "default_popup": "popup.html"
  },
  "description": "Icampus Manager",
  "author": "shorecrab",

  "content_scripts": [
    {
      "matches": ["*://lcms.skku.edu/*"],
      "all_frames": true,
      "js": ["./player.js"]
    },
    {
      "matches": ["*://canvas.skku.edu/*"],
      "js": ["./canvas.js"]
    }
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "options_ui": {
    "page": "index.html",
    "open_in_tab": true
  },
  "permissions": ["cookies", "storage", "tabs", "scripting"],
  "host_permissions": ["*://canvas.skku.edu/*", "*://lcms.skku.edu/*"],
  "browser_specific_settings": {
    "gecko": {
      "id": "icampus-manager@shorecrab",
      "strict_min_version": "121.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
